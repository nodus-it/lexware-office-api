<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         processIsolation="false"
         stopOnFailure="false"
         cacheDirectory=".phpunit.cache"
         backupGlobals="false"
         backupStaticProperties="false">
    
    <!-- Test Suites -->
    <testsuites>
        <testsuite name="Unit Tests">
            <directory suffix="Test.php">tests</directory>
            <exclude>tests/Performance</exclude>
        </testsuite>
        <testsuite name="Performance Tests">
            <directory suffix="Test.php">tests/Performance</directory>
        </testsuite>
    </testsuites>

    <!-- Source Code Coverage -->
    <source>
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory>src/config</directory>
            <file>src/LexwareOfficeServiceProvider.php</file>
        </exclude>
    </source>

    <!-- Logging and Reports -->
    <logging>
        <junit outputFile="tests/results/junit.xml"/>
        <testdoxHtml outputFile="tests/results/testdox.html"/>
        <testdoxText outputFile="tests/results/testdox.txt"/>
    </logging>

    <!-- Coverage Reports -->
    <coverage>
        <report>
            <html outputDirectory="tests/results/coverage-html" lowUpperBound="50" highLowerBound="80"/>
            <clover outputFile="tests/results/coverage.xml"/>
            <cobertura outputFile="tests/results/cobertura.xml"/>
            <text outputFile="tests/results/coverage.txt" showUncoveredFiles="true"/>
        </report>
    </coverage>

    <!-- PHP Settings -->
    <php>
        <!-- Environment Variables for Testing -->
        <env name="APP_ENV" value="testing"/>
        <env name="LEXWARE_OFFICE_API_TOKEN" value="test-token-12345"/>
        <env name="LEXWARE_OFFICE_API_URL" value="https://api.lexware.io/v1/"/>
        <env name="LEXWARE_OFFICE_CONNECT_TIMEOUT" value="10"/>
        <env name="LEXWARE_OFFICE_REQUEST_TIMEOUT" value="10"/>
        <env name="LEXWARE_OFFICE_RATE_LIMIT_RPS" value="10"/>
        <env name="LEXWARE_OFFICE_BURST_LIMIT" value="50"/>
        <env name="LEXWARE_OFFICE_PAGE_SIZE" value="25"/>
        <env name="LEXWARE_OFFICE_MAX_PAGE_SIZE" value="250"/>
        <env name="LEXWARE_OFFICE_CACHE_ENABLED" value="false"/>
        <env name="LEXWARE_OFFICE_LOGGING_ENABLED" value="false"/>
        
        <!-- PHP Settings -->
        <ini name="memory_limit" value="512M"/>
        <ini name="error_reporting" value="-1"/>
        <ini name="display_errors" value="1"/>
        <ini name="display_startup_errors" value="1"/>
    </php>

    <!-- Groups for organizing tests -->
    <groups>
        <include>
            <group>unit</group>
            <group>integration</group>
        </include>
        <exclude>
            <group>performance</group>
            <group>slow</group>
        </exclude>
    </groups>
</phpunit>
